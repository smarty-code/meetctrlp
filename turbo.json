{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"format": {},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"start": {
			"cache": false,
			"persistent": true
		}
	}
}
