DATABASE_URL=

# Primary Firebase Admin configuration: base64-encoded service-account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Web API key from Firebase Console > Project settings > General.
FIREBASE_WEB_API_KEY=

# Optional bucket override.
FIREBASE_STORAGE_BUCKET=

# Fallback when FIREBASE_SERVICE_ACCOUNT_BASE64 is not set.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Shared key used by the desktop agent to upload printer inventory snapshots.
PRINTER_INVENTORY_API_KEY=

# Public origin of the print-user web app. Used for shop QR / customer URLs.
PRINT_USER_ORIGIN=http://localhost:3002

# Railway S3-compatible object storage for uploaded print documents.
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
