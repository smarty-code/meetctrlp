DATABASE_URL=

# Primary Firebase Admin configuration: base64-encoded service-account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Web API key from Firebase Console > Project settings > General.
FIREBASE_WEB_API_KEY=

# Optional bucket override.
FIREBASE_STORAGE_BUCKET=

# Fallback when FIREBASE_SERVICE_ACCOUNT_BASE64 is not set.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Shared key used by the desktop agent to upload printer inventory snapshots.
PRINTER_INVENTORY_API_KEY=

# Realtime Database for the shop doorbell (/doorbell/{shopId}). Unset = rings are skipped.
# Production: https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app
# Emulator:   http://127.0.0.1:9000?ns=<project>-default-rtdb
FIREBASE_DATABASE_URL=

# 1 = log Firestore reads/writes and doorbell rings per request (request_ops). Staging only.
FIRESTORE_OP_COUNTERS=

# Signs the guest cookie (32+ random characters). Required in production; development
# falls back to a per-process secret, so guests start over when the dev server restarts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PRINT_USER_COOKIE_SECRET=

# Shared secret Cloud Scheduler sends to POST /api/v1/internal/maintenance/daily
# (header x-ctrlp-maintenance-secret). Unset = the route always returns 401.
CTRLP_MAINTENANCE_SECRET=
# Development only: lets the web app confirm ONLINE payments without a gateway.
# Never set this where real orders are taken. Put it in .env.development.local,
# which only `next dev` reads (.env and .env.local are also loaded in production).
ALLOW_MOCK_PAYMENTS=

# Public origin of the print-user web app. Used for shop QR / customer URLs.
PRINT_USER_ORIGIN=http://localhost:3002

# Railway S3-compatible object storage for uploaded print documents.
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
