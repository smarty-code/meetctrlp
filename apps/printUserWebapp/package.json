{
  "name": "printUserWebapp",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --config ../../packages/config/prettier/index.mjs --ignore-path ../../packages/config/prettier/.prettierignore --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@ctrlp/config": "workspace:*",
    "@ctrlp/ui": "workspace:*",
    "embla-carousel-react": "^8.6.0",
    "firebase": "12.19.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.145.0"
  }
}
