# Every variable, with notes and a ready-to-paste block: docs/deploy/ENVIRONMENT.md, section 2.

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Firebase web config for the order tracking page's live listener (Firebase Console >
# Project settings > Your apps > Web app). Built into the app, so needed at build time.
# Leave unset to have the tracking page read the order once, with a Refresh button.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only. Same value as the API's CTRLP_PROXY_SECRET: signs the visitor IP the /api proxy sends.
CTRLP_PROXY_SECRET=
