# CtrlP print partner site. Copy to .env.local and adjust. Validated by src/config/env.ts (PRD 9.12).

# Public (inlined into the client bundle)
NEXT_PUBLIC_SITE_DOMAIN=localhost:3002
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_CONTACT_EMAIL=hello@meetctrlp.in
NEXT_PUBLIC_APP_URL=https://app.meetctrlp.in
NEXT_PUBLIC_MAIN_SITE_URL=https://meetctrlp.in
NEXT_PUBLIC_SHOW_PRICING=false
# Leave empty to disable Plausible; set your Plausible site domain when enabled
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Server-only: request-a-call delivery (set a webhook, the three email values, or both)
# Site runs without these; the call form falls back to "try WhatsApp" until one channel is set.
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=