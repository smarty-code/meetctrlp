# Primary Firebase Admin configuration: base64-encoded service-account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Web API key from Firebase Console > Project settings > General.
# Required for server-mediated email/password sign-up, sign-in, and token refresh.
FIREBASE_WEB_API_KEY=

# Optional bucket override.
FIREBASE_STORAGE_BUCKET=

# Fallback when FIREBASE_SERVICE_ACCOUNT_BASE64 is not set.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Railway Storage Bucket / S3-compatible object storage.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
