{
  "name": "ctrlp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "webapp:dev": "pnpm --filter printUserWebapp dev",
    "webapp:build": "pnpm --filter printUserWebapp build",
    "webapp:start": "pnpm --filter printUserWebapp start",
    "webapp:lint": "pnpm --filter printUserWebapp lint",
    "webapp:format": "pnpm --filter printUserWebapp format",
    "webapp:typecheck": "pnpm --filter printUserWebapp typecheck",
    "server:dev": "pnpm --filter server dev",
    "server:build": "pnpm --filter server build",
    "server:start": "pnpm --filter server start",
    "server:lint": "pnpm --filter server lint",
    "server:typecheck": "pnpm --filter server typecheck",
    "@ctrlp/ui:typecheck": "pnpm --filter @ctrlp/ui typecheck",
    "dev": "pnpm run webapp:dev",
    "build": "pnpm run webapp:build",
    "start": "pnpm run webapp:start",
    "lint": "pnpm run webapp:lint",
    "format": "pnpm run webapp:format",
    "typecheck": "pnpm run webapp:typecheck",
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "lint:all": "turbo run lint",
    "format:all": "turbo run format",
    "typecheck:all": "turbo run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
