{
  "name": "ctrlp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "webapp:dev": "pnpm --filter printUserWebapp dev",
    "webapp:build": "pnpm --filter printUserWebapp build",
    "webapp:start": "pnpm --filter printUserWebapp start",
    "webapp:lint": "pnpm --filter printUserWebapp lint",
    "webapp:format": "pnpm --filter printUserWebapp format",
    "webapp:typecheck": "pnpm --filter printUserWebapp typecheck",
    "server:dev": "pnpm --filter server dev",
    "server:build": "pnpm --filter server build",
    "server:start": "pnpm --filter server start",
    "server:lint": "pnpm --filter server lint",
    "server:typecheck": "pnpm --filter server typecheck",
    "agent:restore": "pnpm --filter print-agent restore",
    "agent:build": "pnpm --filter print-agent build",
    "agent:test": "pnpm --filter print-agent test",
    "agent:dev": "pnpm --filter print-agent dev",
    "agent:publish": "pnpm --filter print-agent publish:sidecar",
    "shop:dev": "pnpm --filter print-shop dev",
    "shop:build": "pnpm --filter print-shop build",
    "shop:test": "pnpm --filter print-shop test",
    "shop:lint": "pnpm --filter print-shop lint",
    "shop:typecheck": "pnpm --filter print-shop typecheck",
    "shop:format": "pnpm --filter print-shop format",
    "desktop:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/desktop-setup.ps1",
    "desktop:sidecar": "pnpm --filter print-shop sidecar",
    "desktop:dev": "pnpm --filter print-shop tauri:dev",
    "desktop:build": "pnpm --filter print-shop tauri:build",
    "desktop:test": "pnpm agent:test && pnpm shop:test",
    "desktop:typecheck": "pnpm shop:typecheck",
    "firebase:typecheck": "pnpm --filter @ctrlp/firebase typecheck",
    "types:typecheck": "pnpm --filter @ctrlp/types typecheck",
    "schemas:typecheck": "pnpm --filter @ctrlp/schemas typecheck",
    "@ctrlp/ui:typecheck": "pnpm --filter @ctrlp/ui typecheck",
    "dev": "pnpm run webapp:dev",
    "build": "pnpm run webapp:build",
    "start": "pnpm run webapp:start",
    "lint": "pnpm run webapp:lint",
    "format": "pnpm run webapp:format",
    "typecheck": "pnpm run webapp:typecheck",
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "lint:all": "turbo run lint",
    "format:all": "turbo run format",
    "typecheck:all": "turbo run typecheck",
    "test:all": "turbo run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.27.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
